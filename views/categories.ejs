<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý Danh Mục - Koi Cafe</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <!-- Thanh menu -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container-fluid">
            <a class="navbar-brand" href="/dashboard">☕ KOI CAFE</a>
            <div class="navbar-nav me-auto">
                <div class="navbar-nav me-auto">
    <div class="navbar-nav me-auto">
    <a class="nav-link fw-bold text-warning" href="/pos">🛒 BÁN HÀNG</a>
    <a class="nav-link" href="/invoices">Hóa Đơn</a>
    <a class="nav-link" href="/tables">Quản lý Bàn</a>
    <a class="nav-link" href="/categories">Danh Mục</a>
    <a class="nav-link" href="/products">Sản Phẩm</a>
    <a class="nav-link" href="/employees">Nhân Sự</a>
</div>
</div>
            </div>
            <div class="d-flex text-white align-items-center">
                <a href="/" class="btn btn-sm btn-danger">Đăng xuất</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="row">
            <!-- Form thêm danh mục -->
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">📁 Thêm Danh Mục</h5>
                    </div>
                    <div class="card-body">
                        <form action="/categories/add" method="POST">
                            <div class="mb-3">
                                <label for="tenDM" class="form-label">Tên Danh Mục</label>
                                <input type="text" class="form-control" id="tenDM" name="tenDM" placeholder="VD: Cà phê pha máy" required>
                            </div>
                            <div class="mb-3">
                                <label for="moTa" class="form-label">Mô tả (Không bắt buộc)</label>
                                <textarea class="form-control" id="moTa" name="moTa" rows="3"></textarea>
                            </div>
                            <button type="submit" class="btn btn-success w-100">Thêm Danh Mục</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Danh sách danh mục -->
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">📋 Danh Sách Danh Mục</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-bordered table-hover text-center">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã DM</th>
                                    <th>Tên Danh Mục</th>
                                    <th>Mô Tả</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (categories.length > 0) { %>
                                    <% categories.forEach(function(dm) { %>
                                        <tr>
                                            <td><%= dm.MaDM %></td>
                                            <td class="fw-bold"><%= dm.TenDM %></td>
                                            <td><%= dm.MoTa || 'Không có mô tả' %></td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="3" class="text-muted">Chưa có danh mục nào.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>