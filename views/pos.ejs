<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>POS - Máy Bán Hàng</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background-color: #f0f2f5; height: 100vh; overflow: hidden; font-family: 'Segoe UI', Tahoma, sans-serif;}
        .pos-navbar { background: #212529; height: 60px; }
        .product-card { cursor: pointer; transition: 0.1s; border: none; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        .product-card:active { transform: scale(0.95); background-color: #f8f9fa; }
        .cart-container { background: white; height: calc(100vh - 60px); display: flex; flex-direction: column; box-shadow: -5px 0 15px rgba(0,0,0,0.05); z-index: 10;}
        .cart-items { flex-grow: 1; overflow-y: auto; padding: 15px; }
        .products-container { height: calc(100vh - 60px); overflow-y: auto; padding: 20px; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-thumb { background: #ccc; border-radius: 4px; }
        
        .table-select-danger { border: 2px solid #dc3545 !important; color: #dc3545 !important; }
        .table-select-success { border: 2px solid #28a745 !important; color: #28a745 !important; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark pos-navbar py-0">
        <div class="container-fluid">
            <a class="btn btn-outline-light btn-sm fw-bold" href="/dashboard"><i class="fas fa-arrow-left"></i> Về Dashboard</a>
            <span class="navbar-text text-warning fw-bold mx-auto fs-5"><i class="fas fa-desktop"></i> KOI CAFE POS</span>
            <div class="text-white small d-flex align-items-center">
    <span class="me-3"><i class="fas fa-user-circle"></i> Xin chào!</span>
    <a href="/logout" class="btn btn-sm btn-danger fw-bold"><i class="fas fa-sign-out-alt"></i> Thoát</a>
</div>
        </div>
    </nav>

    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- CỘT 1: CHỌN MÓN -->
            <div class="col-md-7 col-lg-8 products-container">
                <div class="row g-3">
                    <% products.forEach(function(sp) { %>
                        <div class="col-xl-3 col-lg-4 col-sm-6">
                            <div class="card product-card h-100 text-center p-3" onclick="addToCart('<%= sp.MaSP %>', '<%= sp.TenSP %>', <%= sp.DonGia %>)">
                                <div class="display-4 mb-2">
                                    <% if(sp.HinhAnh) { %> 
                                        <img src="<%= sp.HinhAnh %>" style="width: 70px; height: 70px; object-fit: cover; border-radius: 50%;"> 
                                    <% } else { %>☕<% } %>
                                </div>
                                <h6 class="fw-bold mb-1 text-dark text-truncate"><%= sp.TenSP %></h6>
                                <div class="text-danger fw-bold"><%= sp.DonGia.toLocaleString('vi-VN') %> đ</div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>

            <!-- CỘT 2: GIỎ HÀNG TẠM TÍNH -->
            <div class="col-md-5 col-lg-4 cart-container border-start">
                <div class="p-3 bg-light border-bottom">
                    <!-- MỚI: Thêm sự kiện onchange để tự động tải món ăn khi chọn bàn -->
                    <select id="maBan" class="form-select form-select-lg fw-bold shadow-sm" onchange="loadTableOrder()">
                        <option value="">-- CHỌN BÀN GỌI MÓN --</option>
                        <% tables.forEach(function(b) { %>
                            <option value="<%= b.MaBan %>" data-status="<%= b.TrangThai %>" class="<%= b.TrangThai !== 'Trong' ? 'text-danger fw-bold' : 'text-success' %>">
                                <%= b.KhuVuc %> - Bàn: <%= b.TenBan %> <%= b.TrangThai !== 'Trong' ? '(Đang có khách)' : '' %>
                            </option>
                        <% }); %>
                    </select>
                </div>
                
                <div class="cart-items bg-white" id="cartItems">
                    <div class="text-center text-muted mt-5"><i class="fas fa-receipt fs-1 mb-3"></i><br>Chưa có món nào</div>
                </div>

                <div class="p-3 bg-light border-top shadow-lg">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fs-5 fw-bold text-dark">TỔNG CỘNG:</span>
                        <span class="fs-2 fw-bold text-danger" id="cartTotal">0 đ</span>
                    </div>
                    
                    <!-- MỚI: Tách thành 2 nút LƯU TẠM và THANH TOÁN -->
                    <div class="row g-2">
                        <div class="col-6">
                            <button class="btn btn-warning btn-lg w-100 fw-bold py-3 shadow-sm text-dark" onclick="processOrder('save')">
                                <i class="fas fa-save"></i> LƯU ORDER
                            </button>
                        </div>
                        <div class="col-6">
                            <button class="btn btn-success btn-lg w-100 fw-bold py-3 shadow-sm" onclick="processOrder('pay')">
                                <i class="fas fa-check-circle"></i> THANH TOÁN
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        let cart = [];

        // 1. Tải món ăn cũ của bàn (nếu có)
        function loadTableOrder() {
            const selectEl = document.getElementById('maBan');
            const maBan = selectEl.value;
            
            // Đổi màu khung chọn bàn cho sinh động
            const selectedOption = selectEl.options[selectEl.selectedIndex];
            if(selectedOption.getAttribute('data-status') === 'Đang phục vụ') {
                selectEl.className = "form-select form-select-lg fw-bold shadow-sm table-select-danger";
            } else {
                selectEl.className = "form-select form-select-lg fw-bold shadow-sm table-select-success";
            }

            if(!maBan) {
                cart = []; renderCart(); return;
            }

            // Gọi API lấy dữ liệu món ăn
            fetch(`/api/table-order/${maBan}`)
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.cart.length > 0) {
                        cart = data.cart;
                    } else {
                        cart = []; // Bàn trống
                    }
                    renderCart();
                });
        }

        // 2. Thêm món vào giỏ hàng
        function addToCart(maSP, tenSP, donGia) {
            let item = cart.find(i => i.maSP == maSP);
            if(item) item.soLuong++; else cart.push({maSP, tenSP, donGia, soLuong: 1});
            renderCart();
        }

        // 3. Thay đổi số lượng
        function changeQty(index, delta) {
            cart[index].soLuong += delta;
            if(cart[index].soLuong <= 0) cart.splice(index, 1);
            renderCart();
        }

        // 4. Vẽ lại giỏ hàng
        function renderCart() {
            let html = ''; let total = 0;
            if(cart.length === 0) {
                html = '<div class="text-center text-muted mt-5"><i class="fas fa-receipt fs-1 mb-3"></i><br>Chưa có món nào</div>';
            } else {
                cart.forEach((item, i) => {
                    let tt = item.donGia * item.soLuong; total += tt;
                    html += `
                    <div class="d-flex justify-content-between align-items-center mb-2 p-2 border rounded bg-white shadow-sm">
                        <div style="flex: 1;">
                            <div class="fw-bold text-dark">${item.tenSP}</div>
                            <div class="text-danger small fw-bold">${item.donGia.toLocaleString('vi-VN')} đ</div>
                        </div>
                        <div class="d-flex align-items-center">
                            <button class="btn btn-sm btn-outline-secondary px-2 fw-bold" onclick="changeQty(${i}, -1)">-</button>
                            <span class="mx-2 fw-bold fs-5">${item.soLuong}</span>
                            <button class="btn btn-sm btn-outline-secondary px-2 fw-bold" onclick="changeQty(${i}, 1)">+</button>
                        </div>
                    </div>`;
                });
            }
            document.getElementById('cartItems').innerHTML = html;
            document.getElementById('cartTotal').innerText = total.toLocaleString('vi-VN') + ' đ';
        }

        // 5. Xử lý Gửi lệnh Xuống Bếp (Lưu) hoặc Thanh toán
        function processOrder(action) {
            if(cart.length === 0) return alert('Hóa đơn chưa có món nào!');
            let maBan = document.getElementById('maBan').value;
            if(!maBan) return alert('Vui lòng chọn Bàn trước!');
            
            // Hỏi xác nhận nếu ấn Thanh toán
            if(action === 'pay' && !confirm('Xác nhận thu tiền và In bill cho bàn này?')) return;

            fetch('/pos/process', {
                method: 'POST', 
                headers: {'Content-Type': 'application/json'}, 
                body: JSON.stringify({ maBan, cart, action })
            }).then(r => r.json()).then(res => {
                if(res.success) { 
                    alert(res.message); 
                    location.reload(); 
                } else {
                    alert('Lỗi: ' + res.message);
                }
            });
        }
    </script>
</body>
</html>