<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>POS - Máy Bán Hàng</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background-color: #f0f2f5; height: 100vh; overflow: hidden; font-family: 'Segoe UI', Tahoma, sans-serif;}
        .pos-navbar { background: #212529; height: 60px; }
        .product-card { cursor: pointer; transition: 0.1s; border: none; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        .product-card:active { transform: scale(0.95); background-color: #f8f9fa; }
        .cart-container { background: white; height: calc(100vh - 60px); display: flex; flex-direction: column; box-shadow: -5px 0 15px rgba(0,0,0,0.05); z-index: 10;}
        .cart-items { flex-grow: 1; overflow-y: auto; padding: 15px; }
        .products-container { height: calc(100vh - 60px); overflow-y: auto; padding: 20px; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-thumb { background: #ccc; border-radius: 4px; }
        
        .table-select-danger { border: 2px solid #dc3545 !important; color: #dc3545 !important; }
        .table-select-success { border: 2px solid #28a745 !important; color: #28a745 !important; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark pos-navbar py-0">
        <div class="container-fluid">
            <a class="btn btn-outline-light btn-sm fw-bold" href="/dashboard"><i class="fas fa-arrow-left"></i> Về Dashboard</a>
            <span class="navbar-text text-warning fw-bold mx-auto fs-5"><i class="fas fa-desktop"></i> KOI CAFE POS</span>
            <div class="text-white small d-flex align-items-center">
                <span class="me-3"><i class="fas fa-user-circle"></i> Xin chào!</span>
                <a href="/logout" class="btn btn-sm btn-danger fw-bold"><i class="fas fa-sign-out-alt"></i> Thoát</a>
            </div>
        </div>
    </nav>

    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- CỘT 1: CHỌN MÓN -->
            <div class="col-md-7 col-lg-8 products-container">
                <div class="row g-3">
                    <% products.forEach(function(sp) { %>
                        <div class="col-xl-3 col-lg-4 col-sm-6">
                            <div class="card product-card h-100 text-center p-3" onclick="addToCart('<%= sp.MaSP %>', '<%= sp.TenSP %>', <%= sp.DonGia %>)">
                                <div class="display-4 mb-2">
                                    <% if(sp.HinhAnh) { %> 
                                        <img src="<%= sp.HinhAnh %>" style="width: 70px; height: 70px; object-fit: cover; border-radius: 50%;"> 
                                    <% } else { %>☕<% } %>
                                </div>
                                <h6 class="fw-bold mb-1 text-dark text-truncate"><%= sp.TenSP %></h6>
                                <div class="text-danger fw-bold"><%= sp.DonGia.toLocaleString('vi-VN') %> đ</div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>

            <!-- CỘT 2: GIỎ HÀNG TẠM TÍNH -->
            <div class="col-md-5 col-lg-4 cart-container border-start">
                <div class="p-3 bg-light border-bottom">
                    <!-- Tự động tải món ăn khi chọn bàn -->
                    <select id="maBan" class="form-select form-select-lg fw-bold shadow-sm" onchange="loadTableOrder()">
                        <option value="">-- CHỌN BÀN GỌI MÓN --</option>
                        <% tables.forEach(function(b) { %>
                            <option value="<%= b.MaBan %>" data-status="<%= b.TrangThai %>" class="<%= b.TrangThai !== 'Trong' ? 'text-danger fw-bold' : 'text-success' %>">
                                <%= b.KhuVuc %> - Bàn: <%= b.TenBan %> <%= b.TrangThai !== 'Trong' ? '(Đang có khách)' : '' %>
                            </option>
                        <% }); %>
                    </select>
                </div>
                
                <div class="cart-items bg-white" id="cartItems">
                    <div class="text-center text-muted mt-5"><i class="fas fa-receipt fs-1 mb-3"></i><br>Chưa có món nào</div>
                </div>

                <!-- KHU VỰC NHẬP THÔNG TIN TÍCH ĐIỂM -->
                <div class="p-3 bg-white border-top">
                    <h6 class="fw-bold text-success mb-2"><i class="fas fa-gift"></i> Khách hàng thành viên</h6>
                    <div class="input-group input-group-sm mb-2">
                        <input type="text" id="khachPhone" class="form-control fw-bold" placeholder="Nhập SĐT để tích điểm..." onblur="checkCustomer()">
                        <button class="btn btn-outline-success fw-bold" type="button" onclick="checkCustomer()">Kiểm tra</button>
                    </div>
                    <!-- Chỗ để hiện Tên và Số điểm -->
                    <div id="khachInfo" class="small text-primary fw-bold mb-2"></div>
                    <!-- Ô nhập tên (Chỉ hiện khi là khách mới) -->
                    <input type="text" id="khachName" class="form-control form-control-sm mb-2" placeholder="Tên khách hàng mới (Bắt buộc)" style="display: none;">
                </div>

                <div class="p-3 bg-light border-top shadow-lg">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fs-5 fw-bold text-dark">TỔNG CỘNG:</span>
                        <span class="fs-2 fw-bold text-danger" id="cartTotal">0 đ</span>
                    </div>
                    
                    <!-- BỘ 3 NÚT: HỦY - LƯU - THANH TOÁN -->
                    <div class="row g-2">
                        <div class="col-3">
                            <!-- Nút Hủy Hóa Đơn -->
                            <button class="btn btn-outline-danger w-100 fw-bold py-3 shadow-sm" onclick="promptCancelOrder()" title="Hủy hóa đơn">
                                <i class="fas fa-trash-alt"></i> HỦY
                            </button>
                        </div>
                        <div class="col-4">
                            <button class="btn btn-warning w-100 fw-bold py-3 shadow-sm text-dark" onclick="processOrder('save')">
                                <i class="fas fa-save"></i> LƯU
                            </button>
                        </div>
                        <div class="col-5">
                            <button class="btn btn-success w-100 fw-bold py-3 shadow-sm" onclick="processOrder('pay')">
                                <i class="fas fa-check-circle"></i> THU TIỀN
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL HỦY HÓA ĐƠN (GHI NHẬN LÝ DO) -->
    <div class="modal fade" id="cancelOrderModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-danger border-2">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold"><i class="fas fa-exclamation-triangle"></i> Hủy Hóa Đơn</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 text-start">
                    <div class="alert alert-warning small fw-bold">
                        Lưu ý: Hành động này sẽ hủy hóa đơn hiện tại và xóa sạch món ăn của bàn này. Thao tác sẽ được lưu vào lịch sử hệ thống!
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold small text-muted">Lý do hủy đơn (*Bắt buộc):</label>
                        <textarea class="form-control fw-bold border-danger text-danger" id="cancelReason" rows="3" placeholder="Ví dụ: Khách đổi ý bỏ về, Nhập sai bàn..." required></textarea>
                    </div>
                    <button type="button" class="btn btn-danger w-100 fw-bold shadow-sm py-2" onclick="confirmCancelOrder()">XÁC NHẬN HỦY BỎ</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let cart = [];
        let currentSubtotal = 0; // Biến lưu tổng tiền để tính toán điểm

        // 1. Tải món ăn cũ của bàn (nếu có)
        function loadTableOrder() {
            const selectEl = document.getElementById('maBan');
            const maBan = selectEl.value;
            
            // Đổi màu khung chọn bàn
            const selectedOption = selectEl.options[selectEl.selectedIndex];
            if(selectedOption.getAttribute('data-status') === 'Đang phục vụ') {
                selectEl.className = "form-select form-select-lg fw-bold shadow-sm table-select-danger";
            } else {
                selectEl.className = "form-select form-select-lg fw-bold shadow-sm table-select-success";
            }

            if(!maBan) {
                cart = []; renderCart(); return;
            }

            // Gọi API lấy dữ liệu
            fetch(`/api/table-order/${maBan}`)
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.cart.length > 0) {
                        cart = data.cart;
                    } else {
                        cart = [];
                    }
                    renderCart();
                });
        }

        // 2. Thêm món vào giỏ hàng
        function addToCart(maSP, tenSP, donGia) {
            let item = cart.find(i => i.maSP == maSP);
            if(item) item.soLuong++; else cart.push({maSP, tenSP, donGia, soLuong: 1});
            renderCart();
        }

        // 3. Thay đổi số lượng
        function changeQty(index, delta) {
            cart[index].soLuong += delta;
            if(cart[index].soLuong <= 0) cart.splice(index, 1);
            renderCart();
        }

        // 4. Vẽ lại giỏ hàng
        function renderCart() {
            let html = ''; let total = 0;
            if(cart.length === 0) {
                html = '<div class="text-center text-muted mt-5"><i class="fas fa-receipt fs-1 mb-3"></i><br>Chưa có món nào</div>';
            } else {
                cart.forEach((item, i) => {
                    let tt = item.donGia * item.soLuong; total += tt;
                    html += `
                    <div class="d-flex justify-content-between align-items-center mb-2 p-2 border rounded bg-white shadow-sm">
                        <div style="flex: 1;">
                            <div class="fw-bold text-dark">${item.tenSP}</div>
                            <div class="text-danger small fw-bold">${item.donGia.toLocaleString('vi-VN')} đ</div>
                        </div>
                        <div class="d-flex align-items-center">
                            <button class="btn btn-sm btn-outline-secondary px-2 fw-bold" onclick="changeQty(${i}, -1)">-</button>
                            <span class="mx-2 fw-bold fs-5">${item.soLuong}</span>
                            <button class="btn btn-sm btn-outline-secondary px-2 fw-bold" onclick="changeQty(${i}, 1)">+</button>
                        </div>
                    </div>`;
                });
            }
            document.getElementById('cartItems').innerHTML = html;
            currentSubtotal = total; 
            document.getElementById('cartTotal').innerText = total.toLocaleString('vi-VN') + ' đ';
            
            if(document.getElementById('khachPhone').value.trim()) {
                checkCustomer();
            }
        }

        // 5. Kiểm tra khách hàng thành viên
        function checkCustomer() {
            const phone = document.getElementById('khachPhone').value.trim();
            const infoBox = document.getElementById('khachInfo');
            const nameBox = document.getElementById('khachName');
            
            if(!phone) { infoBox.innerText = ''; nameBox.style.display = 'none'; return; }

            fetch('/api/customer/' + phone)
                .then(res => res.json())
                .then(result => {
                    if(result.success) {
                        infoBox.innerHTML = `👋 Chào <b>${result.data.TenKH}</b> - Hiện có: <span class="badge bg-warning text-dark">${result.data.DiemTichLuy} điểm</span>`;
                        nameBox.style.display = 'none';
                        nameBox.value = result.data.TenKH;
                    } else {
                        infoBox.innerHTML = `✨ Khách mới! Sẽ được cộng <b>${Math.floor(currentSubtotal / 10000)} điểm</b>.`;
                        nameBox.style.display = 'block';
                        nameBox.value = '';
                    }
                });
        }

        // 6. Xử lý Gửi lệnh (Lưu hoặc Thanh toán)
        function processOrder(action) {
            if(cart.length === 0) return alert('Hóa đơn chưa có món nào!');
            let maBan = document.getElementById('maBan').value;
            if(!maBan) return alert('Vui lòng chọn Bàn trước!');
            
            let sdtKhach = document.getElementById('khachPhone').value.trim();
            let tenKhach = document.getElementById('khachName').value.trim();

            if (action === 'pay' && sdtKhach && !tenKhach && document.getElementById('khachName').style.display === 'block') {
                return alert('Vui lòng nhập Tên cho khách hàng mới để tạo thẻ thành viên!');
            }

            if(action === 'pay' && !confirm('Xác nhận thu tiền và Khóa hóa đơn cho bàn này?')) return;

            fetch('/pos/process', {
                method: 'POST', 
                headers: {'Content-Type': 'application/json'}, 
                body: JSON.stringify({ maBan, cart, action, sdtKhach, tenKhach })
            }).then(r => r.json()).then(res => {
                if(res.success) { 
                    alert(res.message); 
                    location.reload(); 
                } else {
                    alert('Lỗi: ' + res.message);
                }
            });
        }

        // ==========================================
        // 7. XỬ LÝ HỦY HÓA ĐƠN
        // ==========================================
        function promptCancelOrder() {
            let maBan = document.getElementById('maBan').value;
            if(!maBan) return alert('Vui lòng chọn Bàn trước!');
            
            // Lấy trạng thái của bàn đang chọn
            const selectEl = document.getElementById('maBan');
            const selectedOption = selectEl.options[selectEl.selectedIndex];
            
            if(selectedOption.getAttribute('data-status') !== 'Đang phục vụ') {
                return alert('Bàn này đang Trống, không có Hóa đơn nào để hủy!');
            }

            // Mở Popup yêu cầu nhập lý do
            var cancelModal = new bootstrap.Modal(document.getElementById('cancelOrderModal'));
            cancelModal.show();
        }

        function confirmCancelOrder() {
            let maBan = document.getElementById('maBan').value;
            let lyDoHuy = document.getElementById('cancelReason').value.trim();
            
            if(!lyDoHuy) return alert("Bắt buộc phải nhập Lý do hủy để lưu vết hệ thống!");

            fetch('/pos/process', {
                method: 'POST', 
                headers: {'Content-Type': 'application/json'}, 
                body: JSON.stringify({ maBan, cart: [], action: 'cancel', lyDoHuy: lyDoHuy })
            }).then(r => r.json()).then(res => {
                if(res.success) { 
                    alert(res.message); 
                    location.reload(); 
                } else {
                    alert('Lỗi: ' + res.message);
                }
            });
        }
    </script>
</body>
</html>